---
// Contrôle du nettoyage OpenStreetMap (page Méthode et section carte).
import DonneesAttendues from "./DonneesAttendues.astro";
const modules = import.meta.glob("../assets/centres_donnees.json", { eager: true, import: "default" });
const c = Object.values(modules)[0] as { statistiques: any } | undefined;
const s = c?.statistiques;
const retires = s ? s.sansTag + s.sansCoordonnees + s.horsMetropole + s.doublons : 0;
const lignes = s
  ? [
      ["Données initiales", s.initial, "Tous les éléments du fichier GeoJSON"],
      ["Tags non correspondants", s.sansTag, "Éléments sans les tags data_center recherchés"],
      ["Coordonnées manquantes", s.sansCoordonnees, "Éléments sans coordonnées exploitables"],
      ["Hors zone géographique", s.horsMetropole, "Éléments situés hors du rectangle de sélection de la métropole"],
      ["Identifiants en doublon", s.doublons, "Identifiants OSM répétés"],
      ["Total des éléments retirés", retires, "Somme des exclusions"],
      ["Éléments conservés", s.conserves, `${((s.conserves / s.initial) * 100).toLocaleString("fr-FR", { maximumFractionDigits: 1 })} % des éléments initiaux`],
    ]
  : [];
---

{s ? (
  <div class="overflow-x-auto">
    <table class="table table-zebra tableau tabulaire">
      <caption>Nettoyage des données OpenStreetMap, étape par étape</caption>
      <thead><tr><th scope="col">Étape</th><th scope="col">Nombre</th><th scope="col">Explication</th></tr></thead>
      <tbody>{lignes.map((l) => <tr><th scope="row">{l[0]}</th><td>{l[1]}</td><td>{l[2]}</td></tr>)}</tbody>
    </table>
  </div>
) : <DonneesAttendues fichiers={["src/assets/centres_donnees.json"]} />}
