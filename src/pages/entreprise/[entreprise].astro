---
// ROUTE C — une page par valeur, générée au build (contenu stable, indexable, partageable par lien).
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import GrapheV5 from "../../components/GrapheV5.astro";
import registre from "../../assets/registre.json";
import fmti from "../../assets/fmti.json";
import serie from "../../assets/google_serie.json";
import { COULEUR_ENTREPRISE, COULEURS_STATUT, conditionsQ3 } from "../../lib/donnees";

export function getStaticPaths() {
  const entreprises = [...new Set(registre.map((d) => d.entreprise))].filter(Boolean);
  return entreprises.map((entreprise) => ({ params: { entreprise } }));
}

const { entreprise } = Astro.params;
const reg = registre as any[];
const lignes = reg.filter((d) => d.entreprise === entreprise);
const manquants = lignes.filter((d) => d.statut === "non_trouve" || d.statut === "a_saisir");
const q3 = conditionsQ3(reg, serie as any).find((c) => c.entreprise === entreprise)!;
const scores = fmti.filter((d) => d.entreprise === entreprise);
const pastille = (s: string) => COULEURS_STATUT[s];
---

<Layout titre={entreprise} description={`Fiche ${entreprise} : ce qui est publié, ce qui manque, et la place dans notre enquête.`}>
  <div class="mx-auto max-w-5xl px-4 py-14">
    <p class="reveal text-sm"><a href="/entreprise/">← Toutes les entreprises</a></p>
    <h1 class="reveal text-4xl mt-2" style={`border-left:8px solid ${COULEUR_ENTREPRISE[entreprise!]}; padding-left:1rem`}>{entreprise}</h1>

    <h2 class="reveal text-2xl mt-10">Ce qui est publié</h2>
    <div class="reveal mt-3 overflow-x-auto">
      <table class="table table-zebra tableau">
        <caption>Chiffres du registre pour {entreprise}</caption>
        <thead><tr><th scope="col">Chiffre</th><th scope="col">Valeur</th><th scope="col">Année</th><th scope="col">Page</th><th scope="col">Statut</th></tr></thead>
        <tbody>
          {lignes.map((d) => (
            <tr>
              <th scope="row"><a href={d.url}>{d.libelle}</a></th>
              <td class="tabulaire">{d.valeur ?? "—"} {d.unite}</td>
              <td>{d.annee ?? "—"}</td>
              <td>{d.page || "—"}</td>
              <td><span class="badge pastille" style={`background:${pastille(d.statut).fond};color:${pastille(d.statut).texte}`}>{pastille(d.statut).label}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="reveal text-2xl mt-10">Ce qui manque</h2>
    {manquants.length ? (
      <ul class="prose-sae reveal mt-3">
        {manquants.map((d) => <li><strong>{d.libelle}</strong> : {d.statut === "non_trouve" ? "non trouvé par notre recherche du 19 octobre 2026" : "existe, à saisir"}. {d.note}</li>)}
      </ul>
    ) : <p class="reveal mt-3">Rien de manquant dans notre registre actuel (hors total 2025, à saisir).</p>}

    <h2 class="reveal text-2xl mt-10">Peut-on vérifier son objectif climat ?</h2>
    <p class="reveal mt-3">Objectif climatique : <strong>{q3.objectifTexte}</strong>. Données de suivi : <strong>{q3.serieTexte}</strong>. Résultat : <strong>{q3.resultat}</strong>. {q3.limite}</p>

    <h2 class="reveal text-2xl mt-10">Transparence (FMTI 2025)</h2>
    <p class="reveal mt-3">
      {scores.map((s, i) => <span>{i > 0 ? " · " : ""}{s.domaine} : <strong class="tabulaire">{s.satisfaits}/{s.total}</strong></span>)}
    </p>

    <h2 class="reveal text-2xl mt-10">Sa ligne dans la chronologie</h2>
    <figure class="reveal mt-3"><GrapheV5 entreprises={[entreprise]} /></figure>
  </div>
</Layout>
