---
// Annexe TP5 : on réutilise la MÊME fonction de graphique (lib/periode.ts) avec seulement deux indicateurs.
import PlotFigure from "./PlotFigure.astro";
import serie from "../assets/google_serie.json";
import { variationsPeriode } from "../lib/donnees";
import { optionsPeriode } from "../lib/periode";

const petitEchantillon = variationsPeriode(serie as any, 2023, 2024).slice(0, 2);
const options = optionsPeriode(petitEchantillon, {
  largeur: 700,
  titre: "Test de réutilisabilité du graphique",
  sousTitre: "Seulement deux indicateurs sont transmis à la fonction.",
});
const alt = "Graphique de test présentant uniquement deux indicateurs pour vérifier que la fonction utilise les données reçues en paramètre.";
---

<div class="figure-sae"><PlotFigure options={options} alt={alt} anim={false} /></div>
