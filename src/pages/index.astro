---
import Layout from "../layouts/Layout.astro";
import GrapheV1 from "../components/GrapheV1.astro";
import GrapheV2 from "../components/GrapheV2.astro";
import GrapheV3 from "../components/GrapheV3.astro";
import GrapheV4 from "../components/GrapheV4.astro";
import GrapheV5 from "../components/GrapheV5.astro";
import GrapheCourbe from "../components/GrapheCourbe.astro";
import GrapheStanford from "../components/GrapheStanford.astro";
import CarteCentres from "../components/CarteCentres.astro";
import TableNettoyageOSM from "../components/TableNettoyageOSM.astro";
import TableCompar from "../components/TableCompar.astro";
import TableFMTI from "../components/TableFMTI.astro";
import TableEnvironnementFMTI from "../components/TableEnvironnementFMTI.astro";
import FicheViz from "../components/FicheViz.astro";
import registre from "../assets/registre.json";
import serie from "../assets/google_serie.json";
import fmti from "../assets/fmti.json";
import { variationsGoogle, IDS_2025, conditionsQ3, donneesChrono, nbSuivi, signe, variationsPeriode, COULEURS_STATUT, publications, nbPublies } from "../lib/donnees";

const reg = registre as any[];
const vars = variationsGoogle(reg).filter((d) => (IDS_2025 as readonly string[]).includes(d.id));
const v = (id: string) => vars.find((d) => d.id === id)!.valeur;
const q3 = conditionsQ3(reg, serie as any);
const chrono = donneesChrono(reg, serie as any);

// Stanford : scores des 3 entreprises = somme des critères satisfaits (fmti.json)
const score = (e: string) => fmti.filter((d) => d.entreprise === e).reduce((n, d) => n + d.satisfaits, 0);
const sat = (dom: string, e: string) => fmti.find((d) => d.domaine === dom && d.entreprise === e)!;

// Q2 : série Google 2019-2024
const g = (an: number) => serie.find((d) => d.annee === an)!;
const mt = (x: number) => (x / 1e6).toLocaleString("fr-FR", { maximumFractionDigits: 2 });
const evol = Math.round(100 * (g(2024).total / g(2019).total - 1));
const p2324 = variationsPeriode(serie as any, 2023, 2024);
const pp = (m: string) => Math.round(p2324.find((d) => d.mesure === m)!.pourcent);

// OpenAI et Mistral : ce qui existe quand même
const existe = (e: string) => reg.filter((d) => d.entreprise === e && d.statut === "primaire").map((d) => d.libelle);
const statutType = (e: string, type: string) => {
  const l = reg.filter((d) => d.entreprise === e && d.type === type);
  return l.some((d) => d.statut === "primaire") ? "Publié par l'entreprise"
    : l.some((d) => d.statut === "presse") ? "Mentionné dans la presse"
    : l.some((d) => d.statut === "a_saisir") ? "Données à intégrer"
    : l.some((d) => d.statut === "non_trouve") ? "Non identifié" : "Non étudié";
};
const pastille = (s: string) => COULEURS_STATUT[s];

// ---------- fiches de visualisation (6 éléments + route d'export) ----------
const ficheV1: [string, string][] = [
  ["1. Question", "Quelles informations environnementales OpenAI, Google et Mistral publient-ils dans les sources étudiées ?"],
  ["2. Famille", "Comparaison de données catégorielles sous forme de matrice de présence et d'absence."],
  ["3. Encodage choisi et pourquoi", "Chaque ligne représente une catégorie d'information environnementale et chaque colonne une entreprise. La couleur et le symbole ✓ indiquent une information publiée, le gris et le symbole — une information non identifiée. Cet encodage permet de comparer rapidement les trois entreprises."],
  ["4. Dénominateur", `Nous avons sélectionné ${publications.length} catégories d'informations environnementales. Le nombre d'informations publiées est rapporté à ces ${publications.length} catégories pour chaque entreprise. Ce n'est pas un score officiel de transparence et les catégories ne sont pas pondérées.`],
  ["5. Titre et sous-titre porteur", `<strong>Titre :</strong> « Objectif daté et bilan annuel : seul Google dans notre corpus ». <strong>Sous-titre :</strong> « Sur ${publications.length} informations recherchées : Google en publie ${nbPublies("Google")}, Mistral ${nbPublies("Mistral")}, OpenAI ${nbPublies("OpenAI")}. »`],
  ["6. Alternative textuelle", `La matrice compare les trois entreprises sur ${publications.length} catégories d'informations environnementales. Google en publie ${nbPublies("Google")}, Mistral ${nbPublies("Mistral")} et OpenAI ${nbPublies("OpenAI")}. Dans notre corpus, seul Google possède à la fois un objectif climatique daté et des bilans annuels d'émissions.`],
];
const routeA = (pourquoi: string) => `<strong>Route A (build).</strong> ${pourquoi}`;

const ficheStanford: [string, string][] = [
  ["1. Question", "Comment les scores de transparence des entreprises d'IA se répartissent-ils, et où se situent Google, OpenAI et Mistral ?"],
  ["2. Famille", "Distribution, sous forme de strip plot (un point par entreprise)."],
  ["3. Encodage choisi et pourquoi", "La position horizontale représente le score sur 100. Chaque point correspond à une entreprise. Les trois entreprises étudiées sont en orange et les autres en gris. La ligne pointillée indique la médiane. La position verticale sert uniquement à éviter les superpositions."],
  ["4. Dénominateur", "Chaque score est rapporté aux 100 critères du FMTI. La distribution porte sur les 13 entreprises évaluées en 2025."],
  ["5. Titre et sous-titre porteur", "<strong>Titre :</strong> « Les entreprises d'IA sont loin d'être toutes aussi transparentes ». <strong>Sous-titre :</strong> « Distribution des scores de 13 entreprises évaluées par Stanford en 2025. Médiane : 35/100. »"],
  ["6. Alternative textuelle", "Treize points représentent les scores de transparence des entreprises. Les valeurs vont de 14 à 95 sur 100. La médiane est de 35. Google obtient 41, OpenAI 35 et Mistral 18. Les trois entreprises étudiées sont mises en évidence."],
];
const ficheFMTI: [string, string][] = [
  ["1. Question", "Dans quels domaines Google, OpenAI et Mistral publient-ils le plus et le moins d'informations sur leurs modèles d'IA ?"],
  ["2. Famille", "Comparaison de valeurs relatives, à l'aide de diagrammes en barres horizontales répartis en trois domaines."],
  ["3. Encodage choisi et pourquoi", "La longueur des barres représente le pourcentage de critères satisfaits. Une couleur distingue chaque entreprise. Les trois groupes utilisent la même échelle de 0 à 100 % pour faciliter les comparaisons."],
  ["4. Dénominateur", "Le nombre de critères de chaque domaine : 34 pour Upstream, 30 pour Model et 36 pour Downstream. Les valeurs sont exprimées en pourcentage pour comparer des domaines de tailles différentes."],
  ["5. Titre et sous-titre porteur", `<strong>Titre :</strong> « En amont, Google satisfait ${sat("Upstream", "Google").satisfaits} critères sur 34, OpenAI ${sat("Upstream", "OpenAI").satisfaits} et Mistral ${sat("Upstream", "Mistral").satisfaits} ». <strong>Sous-titre :</strong> « Part des critères de transparence satisfaits par les trois entreprises selon les domaines du FMTI 2025. »`],
  ["6. Alternative textuelle", `Trois groupes de barres comparent la transparence de Google, OpenAI et Mistral. Dans Upstream, Google satisfait ${sat("Upstream", "Google").satisfaits} critères sur 34, OpenAI ${sat("Upstream", "OpenAI").satisfaits} et Mistral aucun. Dans Model, Google et OpenAI satisfont ${sat("Model", "Google").satisfaits} critères sur 30 et Mistral ${sat("Model", "Mistral").satisfaits}. Dans Downstream, OpenAI satisfait ${sat("Downstream", "OpenAI").satisfaits} critères sur 36, Google ${sat("Downstream", "Google").satisfaits} et Mistral ${sat("Downstream", "Mistral").satisfaits}.`],
];
const ficheV3: [string, string][] = [
  ["1. Question", "Quand la consommation électrique de Google augmente, ses émissions de gaz à effet de serre diminuent-elles aussi ?"],
  ["2. Famille", "Comparaison de variations annuelles à l'aide de barres horizontales divergentes."],
  ["3. Encodage choisi et pourquoi", "La longueur des barres représente la variation en pourcentage. Les hausses sont à droite de zéro et les baisses à gauche. Le violet représente la consommation électrique et l'ocre les émissions de gaz à effet de serre. Cet encodage facilite la comparaison des évolutions."],
  ["4. Dénominateur", "Chaque variation est calculée par rapport à la valeur du même indicateur en 2024 : (valeur 2025 − valeur 2024) / valeur 2024 × 100. Les trois indicateurs ont des périmètres différents."],
  ["5. Titre et sous-titre porteur", `<strong>Titre :</strong> « Google : l'électricité augmente, mais ses émissions évoluent différemment ». <strong>Sous-titre :</strong> « En 2025 par rapport à 2024 : électricité ${signe(v("g_elec_2025"))} %, émissions opérationnelles ${signe(v("g_ops_2025"))} %, chaîne d'approvisionnement ${signe(v("g_scope3_2025"))} %. »`],
  ["6. Alternative textuelle", `Le graphique présente trois barres horizontales. La demande d'électricité de Google augmente de ${v("g_elec_2025")} %, les émissions de sa chaîne d'approvisionnement augmentent de ${v("g_scope3_2025")} % et ses émissions opérationnelles diminuent de ${Math.abs(v("g_ops_2025"))} %. Ces variations concernent l'ensemble des activités de Google et non uniquement Gemini.`],
];
const ficheCourbe: [string, string][] = [
  ["1. Question", "Comment les émissions totales de Google ont-elles évolué entre 2019 et 2024 ?"],
  ["2. Famille", "Évolution temporelle, représentée par une courbe."],
  ["3. Encodage choisi et pourquoi", "L'axe horizontal représente les années et l'axe vertical les émissions en millions de tonnes de CO₂e. Les points indiquent les valeurs annuelles et la ligne permet de visualiser leur évolution."],
  ["4. Dénominateur", `Il s'agit d'émissions annuelles absolues, sans dénominateur de normalisation. Pour calculer l'évolution de ${evol} %, la valeur de 2019 sert de référence.`],
  ["5. Titre et sous-titre porteur", `<strong>Titre :</strong> « Les émissions totales de Google ont augmenté de ${evol} % entre 2019 et 2024 ». <strong>Sous-titre :</strong> « Émissions annuelles déclarées, scopes 1, 2 (market-based) et 3 total. »`],
  ["6. Alternative textuelle", `Une courbe présente les émissions totales déclarées de Google entre 2019 et 2024. Elles passent de ${(g(2019).total / 1e6).toFixed(2)} à ${(g(2024).total / 1e6).toFixed(2)} millions de tonnes de CO₂e, soit une augmentation d'environ ${evol} %. Après une diminution en 2020, elles augmentent chaque année jusqu'en 2024.`],
];
const ficheChrono: [string, string][] = [
  ["1. Question", "Pour quelles années disposons-nous d'informations environnementales permettant de suivre les engagements climatiques de Google, OpenAI et Mistral ?"],
  ["2. Famille", "Comparaison temporelle sous forme de matrice chronologique."],
  ["3. Encodage choisi et pourquoi", "L'axe horizontal représente les années et l'axe vertical les entreprises. Chaque case indique la nature des informations identifiées : suivi annuel, information ponctuelle, absence de donnée identifiée ou objectif annoncé. Les couleurs et les lettres permettent de distinguer ces catégories sans dépendre uniquement de la couleur."],
  ["4. Dénominateur", "La période étudiée comprend 7 années, de 2019 à 2025. Le nombre d'années avec suivi annuel est rapporté à ces 7 années pour chaque entreprise. L'échéance 2030 est affichée séparément et ne fait pas partie du dénominateur."],
  ["5. Titre et sous-titre porteur", `<strong>Titre :</strong> « Des données annuelles inégales pour suivre les engagements climatiques ». <strong>Sous-titre :</strong> « Années avec un bilan d'émissions identifié entre 2019 et 2025 — Google : ${nbSuivi(chrono, "Google")} sur 7 · OpenAI : ${nbSuivi(chrono, "OpenAI")} sur 7 · Mistral : ${nbSuivi(chrono, "Mistral")} sur 7. »`],
  ["6. Alternative textuelle", "La chronologie compare les informations environnementales identifiées pour Google, OpenAI et Mistral entre 2019 et 2025. Google possède des valeurs annuelles d'émissions totales déclarées entre 2019 et 2024. Pour OpenAI et Mistral, notre corpus ne contient pas de série annuelle comparable. Les cases distinguent les données annuelles, les publications ponctuelles, les absences d'informations identifiées et les objectifs pour 2030."],
];
const ficheV4: [string, string][] = [
  ["1. Question", "Si le lecteur choisit deux années, de combien la consommation électrique et les émissions de Google ont-elles augmenté ou diminué entre ces deux dates ?"],
  ["2. Famille", "Comparaison interactive de variations temporelles, représentées par un diagramme en barres horizontales divergentes."],
  ["3. Encodage choisi et pourquoi", "La longueur des barres représente la variation en pourcentage. Les augmentations apparaissent à droite de zéro et les diminutions à gauche. Chaque couleur correspond à un indicateur. Deux menus déroulants permettent de sélectionner une année de départ et une année d'arrivée ; le graphique se met à jour selon ce choix."],
  ["4. Dénominateur", "Chaque variation est calculée par rapport à la valeur de l'indicateur pour l'année de départ : (valeur d'arrivée − valeur de départ) / valeur de départ × 100. Les indicateurs ont des unités et des périmètres différents."],
  ["5. Titre et sous-titre porteur", `Le titre est dynamique et présente le principal résultat de la période choisie. Exemple : « De 2023 à 2024, les émissions opérationnelles font ${signe(pp("Émissions opérationnelles"))} % mais les émissions totales font ${signe(pp("Émissions totales"))} % ». Le sous-titre précise que les variations concernent les deux années sélectionnées et indique leur source.`],
  ["6. Alternative textuelle", `Le graphique présente les variations de consommation électrique et d'émissions de Google entre les années choisies. Par exemple, entre 2023 et 2024, l'électricité augmente d'environ ${pp("Électricité")} %, les émissions totales de ${pp("Émissions totales")} %, les émissions opérationnelles diminuent de ${Math.abs(pp("Émissions opérationnelles"))} % et le scope 3 augmente de ${pp("Scope 3")} %. L'alternative textuelle est actualisée selon les années sélectionnées.`],
];
const ficheCarte: [string, string][] = [
  ["1. Question", "Où se trouvent les centres de données identifiés dans OpenStreetMap en France métropolitaine ?"],
  ["2. Famille", "Carte de lieux, sous forme de points géographiques."],
  ["3. Encodage choisi et pourquoi", "Chaque point représente un élément géographique identifié comme centre de données dans OpenStreetMap. Sa position correspond aux coordonnées extraites. Nous avons choisi une carte de points car notre question porte sur la localisation des infrastructures et non sur leur consommation électrique. Le survol donne les informations disponibles sur chaque élément."],
  ["4. Dénominateur", "Aucun dénominateur : nous représentons des emplacements et non une densité ou un taux. Après nettoyage, 373 éléments cartographiques sont conservés sur 384. Ce nombre ne correspond pas nécessairement à 373 centres de données distincts et ne constitue pas un recensement exhaustif."],
  ["5. Titre et sous-titre porteur", "<strong>Titre :</strong> « Où se trouvent les centres de données identifiés en France ? ». <strong>Sous-titre :</strong> « 373 éléments cartographiques recensés dans OpenStreetMap, après nettoyage. »"],
  ["6. Alternative textuelle", "Carte de France métropolitaine représentant 373 éléments cartographiques associés à des centres de données dans OpenStreetMap. Chaque point indique la position approximative d'un élément recensé. Plusieurs éléments peuvent appartenir à un même site. La carte ne permet pas de connaître leur consommation électrique ni d'identifier lesquels sont utilisés pour l'IA générative."],
];
---

<Layout accueil={true}>
  <!-- HERO -->
  <section class="hero overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28 hero-decor">
      <p class="reveal eyebrow">SAE 303 · Défi A · L'impact environnemental de l'IA générative</p>
      <h1 class="reveal mt-5 text-4xl md:text-6xl max-w-4xl tracking-tight" style="--d:80ms">OpenAI, Google et Mistral publient-ils assez de chiffres pour qu'on puisse vérifier s'ils tiennent leurs objectifs climat ?</h1>
      <p class="reveal mt-6 text-lg max-w-2xl" style="--d:160ms">Un dossier de vérification : ce que ces entreprises promettent, ce qu'elles publient, et si cela suffit à un tiers pour contrôler la promesse.</p>
      <p class="reveal mt-8 flex flex-wrap gap-3" style="--d:240ms">
        <a href="#contexte" class="btn btn-primary btn-lg rounded-full no-underline">Commencer l'enquête</a>
        <a href="/methode/" class="btn btn-outline btn-primary btn-lg rounded-full no-underline">Voir la méthode</a>
      </p>
    </div>
  </section>

  <!-- 01 CONTEXTE -->
  <section id="contexte" class="item bg-carte py-16">
    <div class="mx-auto max-w-6xl px-4">
      <p class="reveal eyebrow">01 · Contexte</p>
      <h2 class="reveal titre-section text-3xl md:text-4xl mt-3 max-w-3xl">Nous ne connaissons pas l'ampleur réelle de la pollution de l'IA générative</h2>
      <div class="prose-sae reveal-stagger mt-6">
        <p class="reveal">Nous savons aujourd'hui que l'intelligence artificielle générative a un impact sur l'environnement. Entraîner et faire fonctionner ces modèles nécessite de l'électricité, mobilise des ressources en eau et génère des émissions de gaz à effet de serre.</p>
        <p class="reveal">Mais il reste difficile de mesurer précisément l'ampleur de ces impacts.</p>
        <p class="reveal">Derrière ChatGPT d'OpenAI, Gemini de Google et Le Chat de Mistral, de nombreux utilisateurs sollicitent chaque jour des infrastructures informatiques dont la consommation et les émissions sont difficiles à évaluer de manière indépendante.</p>
        <p class="reveal">Les chercheurs peuvent produire des estimations, mais les entreprises détiennent une grande partie des informations nécessaires pour connaître l'impact réel de leurs technologies.</p>
        <p class="reveal"><strong>Alors, que choisissent-elles de rendre public ?</strong> Communiquent-elles suffisamment de chiffres pour permettre une vérification indépendante de leurs engagements climatiques ? Ou certaines informations essentielles restent-elles dans l'ombre ?</p>
        <p class="reveal">À travers plusieurs visualisations, nous allons comparer leurs engagements, leurs chiffres publiés et les informations manquantes pour déterminer dans quelle mesure leurs objectifs climatiques peuvent être vérifiés.</p>
      </div>

      <div class="reveal mt-8 overflow-x-auto">
        <table class="table table-zebra tableau">
          <caption>Les trois entreprises étudiées</caption>
          <thead><tr><th scope="col">Entreprise</th><th scope="col">Pays</th><th scope="col">Service d'IA générative étudié</th></tr></thead>
          <tbody>
            <tr><th scope="row"><span class="inline-block w-3 h-3 rounded-full mr-2" style="background:#D6336C" aria-hidden="true"></span>OpenAI</th><td>États-Unis</td><td>ChatGPT</td></tr>
            <tr><th scope="row"><span class="inline-block w-3 h-3 rounded-full mr-2" style="background:#2B6CB0" aria-hidden="true"></span>Google</th><td>États-Unis</td><td>Gemini</td></tr>
            <tr><th scope="row"><span class="inline-block w-3 h-3 rounded-full mr-2" style="background:#F59E0B" aria-hidden="true"></span>Mistral AI</th><td>France</td><td>Le Chat</td></tr>
          </tbody>
        </table>
      </div>
      <p class="reveal mt-3 max-w-3xl"><strong>Notre objectif est de comparer leur transparence, et non de déterminer laquelle pollue le moins.</strong> Nous distinguerons les impacts d'un modèle, ceux d'une requête et les émissions de l'entreprise dans son ensemble.</p>

      <div class="reveal mt-10 grid gap-6 md:grid-cols-2">
        <div class="card bg-base-100 border border-bord card-body p-6">
          <h3 class="text-xl">Notre angle : vérifier plutôt que croire</h3>
          <p class="mt-2">Nous ne cherchons pas à déterminer quelle entreprise est la plus écologique. Nous analysons les engagements climatiques d'OpenAI, de Google et de Mistral, les données environnementales qu'ils publient et la possibilité de vérifier leurs promesses. <strong>Les informations manquantes sont également un résultat de notre enquête.</strong></p>
          <p class="mt-2 text-sm">Pour qui ? Les citoyens et les utilisateurs de l'IA générative, qui n'ont pas forcément d'ordre de grandeur en tête concernant son impact environnemental.</p>
        </div>
        <div class="card bg-base-100 border border-bord card-body p-6">
          <h3 class="text-xl">Trois questions</h3>
          <ol class="list-decimal ml-5 mt-2 grid gap-1">
            <li>Qu'ont promis OpenAI, Google et Mistral, et que publient-ils pour qu'on puisse le vérifier ?</li>
            <li>Quand leur consommation explose, leurs émissions baissent-elles vraiment ?</li>
            <li>Les chiffres publiés suffisent-ils à mesurer les progrès vers les objectifs climat annoncés ?</li>
          </ol>
        </div>
      </div>
      <p class="reveal mt-6 text-sm">Les sources, la provenance des données, les cinq questions posées avant de dessiner, le nettoyage et les jointures sont détaillés dans la page <a href="/methode/">Méthode</a>.</p>
    </div>
  </section>

  <!-- 02 EXPLORATION -->
  <section id="exploration" class="item bg-fond py-16">
    <div class="mx-auto max-w-6xl px-4">
      <p class="reveal eyebrow">02 · Exploration · Question 1</p>
      <h2 class="reveal titre-section text-3xl md:text-4xl mt-3 max-w-3xl">Les trois entreprises communiquent, mais pas sur les mêmes chiffres</h2>
      <p class="reveal mt-2 text-fonce font-semibold">Qu'ont promis OpenAI, Google et Mistral, et que publient-ils pour qu'on puisse le vérifier ?</p>

      <div class="prose-sae reveal mt-6">
        <p>Pour savoir si OpenAI, Google et Mistral respectent leurs engagements climatiques, il faut d'abord identifier les objectifs qu'ils annoncent et les informations environnementales qu'ils rendent publiques. Certaines entreprises publient des bilans annuels de leurs émissions, tandis que d'autres fournissent principalement des estimations concernant un modèle ou une requête.</p>
        <p><strong>Publier des chiffres ne signifie pas forcément qu'un engagement climatique peut être vérifié.</strong> Nous comparons donc d'abord les informations disponibles : engagements climatiques, émissions de CO₂, consommation énergétique, consommation d'eau et méthodes de calcul.</p>
        <p class="text-sm"><em>Une information non identifiée dans notre recherche ne signifie pas nécessairement qu'elle n'existe pas.</em></p>
      </div>

      <figure class="reveal mt-8"><GrapheV1 /></figure>
      <FicheViz titre="Matrice de transparence" lignes={ficheV1} route={routeA("Données figées, lecture seule : le SVG est produit au build avec Plot et JSDOM et injecté dans la page. Zéro JavaScript chez le lecteur, le détail au survol vient des balises <code>title</code> du SVG.")} />
      <div class="prose-sae reveal mt-6">
        <h3>Analyse</h3>
        <p>Sur les <strong>{publications.length} catégories d'informations recherchées</strong> :</p>
        <ul>
          <li><strong>Google : {nbPublies("Google")} sur {publications.length}.</strong> L'entreprise publie des objectifs climatiques datés et des bilans annuels de ses émissions. Elle communique aussi des estimations d'énergie, d'eau et de CO₂e pour un prompt textuel médian de Gemini.</li>
          <li><strong>Mistral : {nbPublies("Mistral")} sur {publications.length}.</strong> Une analyse environnementale de Mistral Large 2, des estimations de CO₂e et d'eau pour une réponse type. Pas de bilan annuel complet ni d'objectif daté dans les sources retenues.</li>
          <li><strong>OpenAI : {nbPublies("OpenAI")} sur {publications.length}.</strong> Des estimations d'électricité et d'eau par requête, communiquées par Sam Altman, sans méthodologie assez détaillée pour les reproduire.</li>
        </ul>
        <p><strong>Google publie le plus de catégories, mais ce résultat doit être nuancé :</strong> un bilan annuel d'entreprise ne mesure pas la même chose qu'une estimation pour une requête, et publier ne signifie pas permettre une vérification indépendante. <strong>Notre premier constat : la quantité d'informations publiées ne suffit pas à mesurer la transparence climatique. Il faut aussi examiner leur précision, leur méthode de calcul et leur périmètre.</strong></p>
        <p class="text-sm"><em>Limite : notre classement repose sur les sources étudiées et sur six catégories choisies pour notre enquête. Il ne représente pas l'ensemble des publications environnementales de ces entreprises.</em></p>
      </div>

      <h3 class="reveal text-2xl mt-14">Qui est transparent sur quoi ? L'indice FMTI de Stanford</h3>
      <div class="prose-sae reveal mt-4">
        <p>En 2023, des chercheurs, notamment de l'université de Stanford, ont créé le <strong>Foundation Model Transparency Index (FMTI)</strong> pour mesurer la transparence des entreprises d'IA à partir d'informations concrètes et vérifiables, plutôt que de se fier à leurs seules déclarations. Dans son édition de <strong>2025</strong>, il évalue 13 entreprises selon <strong>100 critères</strong>. Pour chaque critère : <strong>1 point si les informations publiées répondent aux exigences, 0 sinon</strong>.</p>
      </div>
      <figure class="reveal mt-6"><GrapheStanford /></figure>
